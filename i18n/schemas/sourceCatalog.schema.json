{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Source Catalog",
	"type": "object",
	"additionalProperties": false,
	"required": ["$schema", "version", "domain", "occurrences"],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "const": 5 },
		"domain": { "enum": ["manifest", "webviews", "quickpicks", "formatter", "webviewHost"] },
		"occurrences": {
			"type": "array",
			"items": { "$ref": "#/definitions/occurrence" }
		}
	},
	"definitions": {
		"sourceReference": {
			"anyOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "file", "segments"],
					"properties": {
						"kind": { "const": "json" },
						"file": { "type": "string" },
						"segments": {
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "type": "integer" }]
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "file"],
					"properties": {
						"kind": { "const": "source" },
						"file": { "type": "string" },
						"attribute": { "type": "string" }
					}
				}
			]
		},
		"outputReference": {
			"anyOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "key"],
					"properties": {
						"kind": { "const": "manifest-key" },
						"key": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "bundle", "key"],
					"properties": {
						"kind": { "const": "runtime-key" },
						"bundle": { "type": "string" },
						"key": { "type": "string" }
					}
				}
			]
		},
		"occurrence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "scope", "anchor", "slot", "authorityId", "pattern", "reference"],
			"properties": {
				"id": { "type": "string" },
				"scope": { "type": "string" },
				"anchor": { "type": "string" },
				"slot": { "type": "string" },
				"authorityId": { "type": "string" },
				"pattern": { "$ref": "./messagePattern.schema.json" },
				"reference": { "$ref": "#/definitions/sourceReference" },
				"output": { "$ref": "#/definitions/outputReference" }
			}
		}
	}
}
