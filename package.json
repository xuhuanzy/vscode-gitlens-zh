{
	"name": "gitlens-zh-layer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"glzh": "node ./scripts/glzh.mts",
		"build": "node ./scripts/glzh.mts build",
		"package": "node ./scripts/glzh.mts package --",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"check": "tsc",
		"test": "vitest run",
		"test:quick": "vitest run --exclude scripts/__tests__/upstream.test.mts"
	},
	"devDependencies": {
		"@types/node": "22.15.21",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.74.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.18.0",
		"pnpm": ">=11.5.1 <12"
	},
	"packageManager": "pnpm@11.5.1"
}
